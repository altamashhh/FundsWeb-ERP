generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SALES
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}


enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SALES)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enquiries    Enquiry[]
  quotations   Quotation[]
}

model Customer {
  id            String   @id @default(uuid())
  companyName   String
  contactPerson String
  mobile        String
  email         String
  city          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enquiries     Enquiry[]
  quotations    Quotation[]
  salesOrders   SalesOrder[]
}

model Product {
  id          String   @id @default(uuid())
  productCode String   @unique
  productName String
  category    String
  unit        String
  basePrice   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory      Inventory?
  enquiryItems   EnquiryItem[]
  quotationItems QuotationItem[]
  orderItems     SalesOrderItem[]
  dispatchItems  DispatchItem[]
}

model Inventory {
  id               String   @id @default(uuid())
  productId        String   @unique
  physicalQuantity Int      @default(0)
  reservedQuantity Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  
}

model Enquiry {
  id           String        @id @default(uuid())
  enquiryNumber String       @unique
  customerId   String
  createdById  String
  enquiryDate  DateTime      @default(now())
  requiredDate DateTime
  notes        String?
  status       EnquiryStatus  @default(NEW)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  items      EnquiryItem[]
  quotations Quotation[]
}

model EnquiryItem {
  id        String @id @default(uuid())
  enquiryId String
  productId String
  quantity  Int

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([enquiryId, productId])
}

model Quotation {
  id             String          @id @default(uuid())
  quotationNumber String         @unique
  enquiryId      String
  customerId     String
  createdById    String
  validUntil     DateTime
  status         QuotationStatus @default(DRAFT)
  subtotal       Decimal         @db.Decimal(12, 2)
  discountAmount Decimal         @db.Decimal(12, 2)
  gstAmount      Decimal         @db.Decimal(12, 2)
  grandTotal     Decimal         @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  enquiry  Enquiry  @relation(fields: [enquiryId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  items      QuotationItem[]
  salesOrder SalesOrder?
}

model QuotationItem {
  id          String  @id @default(uuid())
  quotationId String
  productId   String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  discountPct Decimal @db.Decimal(5, 2) @default(0)
  gstPct      Decimal @db.Decimal(5, 2) @default(0)
  lineAmount  Decimal @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
}

model SalesOrder {
  id                String           @id @default(uuid())
  orderNumber       String           @unique
  customerId        String
  quotationId       String           @unique
  orderDate         DateTime         @default(now())
  totalAmount       Decimal          @db.Decimal(12, 2)
  status            SalesOrderStatus @default(PENDING)
  inventoryReserved Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  customer  Customer  @relation(fields: [customerId], references: [id])
  quotation Quotation @relation(fields: [quotationId], references: [id])

  items      SalesOrderItem[]
  dispatches Dispatch[]
}

model SalesOrderItem {
  id           String @id @default(uuid())
  salesOrderId String
  productId    String
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([salesOrderId, productId])
}

model Dispatch {
  id            String   @id @default(uuid())
  dispatchNumber String   @unique
  salesOrderId  String
  dispatchDate  DateTime @default(now())
  vehicleNumber String
  driverName    String
  createdAt     DateTime @default(now())

  salesOrder SalesOrder    @relation(fields: [salesOrderId], references: [id])
  items      DispatchItem[]
}

model DispatchItem {
  id         String @id @default(uuid())
  dispatchId String
  productId  String
  quantity   Int

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}